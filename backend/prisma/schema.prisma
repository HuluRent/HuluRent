generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                    @id @default(uuid())
  email                String                    @unique
  phone                String?                   @unique
  passwordHash         String
  role                 Role                      @default(USER)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  auditEvents          AuditEvent[]
  bookingsAsOwner      Booking[]                 @relation("BookingOwner")
  bookingsAsRenter     Booking[]                 @relation("BookingRenter")
  conversations        ConversationParticipant[]
  evidenceSubmitted    Evidence[]
  identityVerification IdentityVerification?
  itemsOwned           Item[]                    @relation("ItemOwner")
  messagesSent         Message[]
  notifications        Notification[]
  profile              Profile?
  reportsFiled         Report[]                  @relation("ReportAuthor")
  reportsAgainst       Report[]                  @relation("ReportSubject")
  reviewsWritten       Review[]                  @relation("ReviewAuthor")
  reviewsReceived      Review[]                  @relation("ReviewSubject")
  savedListings        SavedListing[]

  @@index([email])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  city        String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model IdentityVerification {
  id         String             @id @default(uuid())
  userId     String             @unique
  status     VerificationStatus @default(UNVERIFIED)
  provider   String?
  reference  String?
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id])
}

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  items    Item[]
}

model Item {
  id             String         @id @default(uuid())
  ownerId        String
  categoryId     String
  name           String
  description    String
  pricePerUnit   Decimal        @db.Decimal(10, 2)
  pricingUnit    String
  depositAmount  Decimal?       @db.Decimal(10, 2)
  latitude       Float?
  longitude      Float?
  approxLocation String
  status         ListingStatus  @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  availabilities Availability[]
  bookings       Booking[]
  category       Category       @relation(fields: [categoryId], references: [id])
  owner          User           @relation("ItemOwner", fields: [ownerId], references: [id])
  images         ItemImage[]
  savedListings  SavedListing[]
  conversations  Conversation[]

  @@index([categoryId])
  @@index([ownerId])
  @@index([status])
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id])
}

model SavedListing {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Item     @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
  @@index([userId])
}

model Availability {
  id        String   @id @default(uuid())
  itemId    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
}

model Booking {
  id           String            @id @default(uuid())
  itemId       String
  ownerId      String
  renterId     String
  startDate    DateTime
  endDate      DateTime
  agreedPrice  Decimal           @db.Decimal(10, 2)
  status       BookingStatus     @default(REQUESTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  item         Item              @relation(fields: [itemId], references: [id])
  owner        User              @relation("BookingOwner", fields: [ownerId], references: [id])
  renter       User              @relation("BookingRenter", fields: [renterId], references: [id])
  conversation Conversation?
  evidence     Evidence[]
  inspections  Inspection[]
  agreements   RentalAgreement[]
  reviews      Review[]

  @@index([itemId, status])
  @@index([ownerId])
  @@index([renterId])
}

model RentalAgreement {
  id             String   @id @default(uuid())
  bookingId      String
  version        Int      @default(1)
  terms          Json
  ownerAccepted  Boolean  @default(false)
  renterAccepted Boolean  @default(false)
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, version])
  @@index([bookingId])
}

model Inspection {
  id          String           @id @default(uuid())
  bookingId   String
  scheduledAt DateTime
  status      InspectionStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  booking     Booking          @relation(fields: [bookingId], references: [id])
}

model Conversation {
  id           String                    @id @default(uuid())
  itemId       String
  bookingId    String?                   @unique
  createdAt    DateTime                  @default(now())
  item         Item                      @relation(fields: [itemId], references: [id])
  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([itemId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
}

model Evidence {
  id                   String       @id @default(uuid())
  bookingId            String
  submittedById        String
  type                 EvidenceType
  photoUrls            String[]
  conditionNotes       String?
  acknowledgedByOwner  Boolean      @default(false)
  acknowledgedByRenter Boolean      @default(false)
  createdAt            DateTime     @default(now())
  booking              Booking      @relation(fields: [bookingId], references: [id])
  submittedBy          User         @relation(fields: [submittedById], references: [id])

  @@index([bookingId, type])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String
  authorId  String
  subjectId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@unique([bookingId, authorId])
  @@index([subjectId])
}

model Report {
  id         String       @id @default(uuid())
  authorId   String
  subjectId  String?
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  author     User         @relation("ReportAuthor", fields: [authorId], references: [id])
  subject    User?        @relation("ReportSubject", fields: [subjectId], references: [id])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
}

enum Role {
  USER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNAVAILABLE
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  ACTIVE
  RETURN_PENDING
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum InspectionStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EvidenceType {
  PICKUP
  RETURN
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}
