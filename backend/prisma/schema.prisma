// HuluRent — Prisma schema
// Lives in: hulurent-backend (prisma/schema.prisma)
// Referenced from: hulurent-docs/ARCHITECTURE.md §3
//
// PostgreSQL. Requires the btree_gist extension for the booking overlap
// exclusion constraint — see the companion raw migration at
// prisma/migrations/manual/booking_overlap_constraint.sql (this repo).

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  UNAVAILABLE
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  CONFIRMED
  ACTIVE
  RETURN_PENDING
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum InspectionStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EvidenceType {
  PICKUP
  RETURN
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// ── Core entities ────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              Profile?
  identityVerification IdentityVerification?

  itemsOwned       Item[]    @relation("ItemOwner")
  bookingsAsOwner  Booking[] @relation("BookingOwner")
  bookingsAsRenter Booking[] @relation("BookingRenter")

  conversations ConversationParticipant[]
  messagesSent  Message[]

  evidenceSubmitted Evidence[]

  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewSubject")

  reportsFiled   Report[] @relation("ReportAuthor")
  reportsAgainst Report[] @relation("ReportSubject")

  notifications Notification[]
  auditEvents   AuditEvent[]

  @@index([email])
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  displayName String
  bio         String?
  avatarUrl   String?
  city        String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IdentityVerification {
  id         String             @id @default(uuid())
  userId     String             @unique
  user       User               @relation(fields: [userId], references: [id])
  status     VerificationStatus @default(UNVERIFIED)
  provider   String?
  reference  String?
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Category {
  id       String     @id @default(uuid())
  name     String     @unique
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  items Item[]
}

model Item {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation("ItemOwner", fields: [ownerId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name          String
  description   String
  pricePerUnit  Decimal  @db.Decimal(10, 2)
  pricingUnit   String // e.g. "day", "hour"
  depositAmount Decimal? @db.Decimal(10, 2)

  latitude       Float
  longitude      Float
  approxLocation String // e.g. "Bole" — public-facing, not exact address

  status ListingStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ItemImage[]
  availabilities Availability[]
  bookings       Booking[]

  @@index([categoryId])
  @@index([ownerId])
  @@index([status])
}

model ItemImage {
  id        String   @id @default(uuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Availability {
  id        String   @id @default(uuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  @@index([itemId])
}

// ── Booking ──────────────────────────────────────────────────────────
// Overlap prevention has TWO layers, deliberately:
//  1. Application layer (hulurent-backend: bookings.conflict-check.js):
//     runs a row-locked transaction (SELECT ... FOR UPDATE) before
//     insert/update, so the API can return a clean, specific error
//     message to the client.
//  2. Database layer: a Postgres EXCLUDE constraint (added via raw SQL
//     migration, see prisma/migrations/manual/booking_overlap_constraint.sql
//     in this repo) as a hard backstop — guarantees no overlapping
//     CONFIRMED/ACTIVE booking can exist for the same item even under a
//     bug or a race condition the app layer misses.
// Prisma cannot express EXCLUDE constraints natively, so it's added in
// a follow-up raw migration rather than in this schema file.

model Booking {
  id       String @id @default(uuid())
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  ownerId  String
  owner    User   @relation("BookingOwner", fields: [ownerId], references: [id])
  renterId String
  renter   User   @relation("BookingRenter", fields: [renterId], references: [id])

  startDate   DateTime
  endDate     DateTime
  agreedPrice Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agreements   RentalAgreement[]
  inspections  Inspection[]
  evidence     Evidence[]
  conversation Conversation?
  reviews      Review[]

  @@index([itemId, status])
  @@index([ownerId])
  @@index([renterId])
}

model RentalAgreement {
  id             String   @id @default(uuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id])
  version        Int      @default(1)
  terms          Json // permitted use, return expectations, cancellation terms, etc.
  ownerAccepted  Boolean  @default(false)
  renterAccepted Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([bookingId, version])
  @@index([bookingId])
}

model Inspection {
  id          String           @id @default(uuid())
  bookingId   String
  booking     Booking          @relation(fields: [bookingId], references: [id])
  scheduledAt DateTime
  status      InspectionStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Conversation {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Evidence {
  id                   String       @id @default(uuid())
  bookingId            String
  booking              Booking      @relation(fields: [bookingId], references: [id])
  submittedById        String
  submittedBy          User         @relation(fields: [submittedById], references: [id])
  type                 EvidenceType
  photoUrls            String[]
  conditionNotes       String?
  acknowledgedByOwner  Boolean      @default(false)
  acknowledgedByRenter Boolean      @default(false)
  createdAt            DateTime     @default(now())

  @@index([bookingId, type])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id])
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([bookingId, authorId])
  @@index([subjectId])
}

model Report {
  id         String       @id @default(uuid())
  authorId   String
  author     User         @relation("ReportAuthor", fields: [authorId], references: [id])
  subjectId  String?
  subject    User?        @relation("ReportSubject", fields: [subjectId], references: [id])
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

